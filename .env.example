# Backend API used by the Nuxt BFF
NUXT_API_BASE=http://localhost:8080/api/v1

# Public backend origin used for OAuth2 redirects
NUXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Frontend origin
NUXT_SITE_URL=http://localhost:3000

# Session cookies. Enable secure cookies when serving over HTTPS.
NUXT_COOKIE_SECURE=false
NUXT_COOKIE_SAME_SITE=lax

# Set only when frontend and backend share a parent cookie domain
NUXT_COOKIE_DOMAIN=

# Backend OAuth2 success redirect must point at:
# http://localhost:3000/auth/callback
